{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": ["index.ts", "src/App.tsx"],
  "ignoreDependencies": [
    "expo-build-properties",
    "expo-build-properties",
    "expo-dev-client",
    "expo-system-ui",
    "immer",
    "eslint-config-prettier",
    "eslint-plugin-import",
    "eslint-import-resolver-typescript",
    "babel-plugin-inline-import",
    "@testing-library/react-native",
    "react-native-svg-transformer",
    "expo-modules-core",
    "@types/jest",
    "jest",
    "jest-expo",
    "@expo/config-plugins",
    "@expo/vector-icons",
    "expo-constants",
    "expo-linking",
    "globals",
    "plugins/**",
    "@appModules/types",
    "@appModules/*",
    "@modules/*",
    "@modules/navigation",
    "@navigation/*",
    "@navigation/types",
    "@navigation/NavStackMain",
    "@navigation/navigationRef",
    "@shared/types",
    "@shared/*",
    "@constants",
    "@constants/*",
    "@store/*",
    "@home/*",
    "@ashram/*",
    "@satsang/*",
    "@gallery/*",
    "@contact/*",
    "@src/*",
    "@/*"
  ],
  "ignorePatterns": [
    "src/modules/**/tests/**",
    "src/shared/**/tests/**",
    "src/tests/**",
    "**/tests/**",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "jest.config.js",
    "jest.setup.js",
    "android/*",
    "ios/*",
    "plugins/**",
    "src/**/types/**"
  ],
  "duplicates": {
    "minOccurrences": 3,
    "ignore": [
      "**/lib/**",
      "**/dist/**",
      "**/node_modules/**",
      "**/docs/**",
      "src/modules/**/tests/**",
      "src/shared/**/tests/**",
      "src/tests/**",
      "**/tests/**",
      "**/*.test.ts",
      "**/*.test.tsx",
      "src/App.tsx",
      "src/appStore/*",
      "android/*",
      "ios/*",
      "plugins/**"
    ],
    "mode": "mild"
  },
  "health": {
    "ignore": [
      "**/*.tsx",
      "src/modules/**/tests/**",
      "src/shared/**/tests/**",
      "src/tests/**",
      "**/tests/**",
      "**/*.test.ts",
      "**/*.test.tsx",
      "plugins/android/withGradleJvmArgs.js",
      "android/*",
      "ios/*",
      "plugins/**"
    ]
  },
  "rules": {
    "circular-dependencies": "error",
    "unused-types": "off",
    "unused-exports": "off"
  }
}
