# Local secrets — copy to `.env` and fill in. Never commit `.env`.

# Absolute path or path relative to the repo root (not android/app).
ANDROID_UPLOAD_STORE_FILE=./credentials/upload-keystore.keystore
ANDROID_UPLOAD_KEY_ALIAS=my-key-alias
ANDROID_UPLOAD_STORE_PASSWORD=
ANDROID_UPLOAD_KEY_PASSWORD=
