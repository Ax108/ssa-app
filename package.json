  "author": "Atanu Debbarma",
  "private": true,
  "license": "UNLICENSED",
  "dependencies": {
    "@expo-google-fonts/freeman": "^0.4.0",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "~7.18.8",
    "@react-navigation/native": "~7.3.8",
    "@react-navigation/native-stack": "~7.17.10",
    "@shopify/flash-list": "2.0.2",
    "babel-preset-expo": "~57.0.2",
    "expo": "~57.0.9",
    "expo-build-properties": "~57.0.8",
    "expo-clipboard": "~57.0.1",
    "expo-dev-client": "~57.0.10",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.11",
    "immer": "11.1.8",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "babel-plugin-inline-import": "~3.0.0",
    "eslint": "~9.39.4",
    "eslint-config-expo": "~57.0.1",
    "eslint-config-prettier": "~10.1.8",
    "eslint-import-resolver-typescript": "~4.4.5",
    "eslint-plugin-import": "~2.32.0",
    "eslint-plugin-jest": "~29.15.4",
    "eslint-plugin-prettier": "~5.5.6",
    "fallow": "~2.96.0",
    "husky": "9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.3",
    "prettier": "~3.8.4",
    "react-native-svg-transformer": "^1.5.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.63.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.0.0"
  },
  "trustedDependencies": [
    "esbuild",
    "unrs-resolver",
    "expo-modules-autolinking",
    "react-native-reanimated"
  ],
  "scripts": {
    "start": "bunx expo start --dev-client",
    "android": "bunx expo run:android",
    "wsl:prebuild-android": "bunx expo prebuild --clean --platform android",
    "build:android:wsl": "chmod +x android/gradlew && cd android && ./gradlew assembleDebug",
    "ios": "bunx expo run:ios",
    "dev": "bunx expo start --dev-client",
    "devClear": "bunx expo start --dev-client -c",
    "tsc": "bunx tsc --noEmit",
    "tsc:app": "bunx tsc --noEmit -p tsconfig.no-tests.json",
    "lint": "bunx eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:app": "bunx eslint . --ext .js,.jsx,.ts,.tsx --ignore-pattern \"**/tests/**\" --ignore-pattern \"**/__tests__/**\" --ignore-pattern \"**/*.test.ts\" --ignore-pattern \"**/*.test.tsx\" --ignore-pattern \"**/*.spec.ts\" --ignore-pattern \"**/*.spec.tsx\" --ignore-pattern \"jest.setup.js\"",
    "format": "bunx prettier --write .",
    "prebuild": "bunx expo prebuild --clean",
    "prebuild:android": "bunx expo prebuild --clean --platform android",
    "prebuild:ios": "bunx expo prebuild --clean --platform ios",
    "android:release": "bunx expo run:android --variant release",
    "build:android:release:wsl": "chmod +x android/gradlew && cd android && ./gradlew assembleRelease",
    "doctor": "bunx expo-doctor",
    "test": "jest",
    "test:watch": "jest --watch",
    "verify": "bun lint && bun tsc && bun tsc:app && bun run test",
    "ota:export": "bun scripts/publish-ota.mjs",
    "ota:export:android": "bun scripts/publish-ota.mjs --platform android",
    "ota:export:ios": "bun scripts/publish-ota.mjs --platform ios",
    "ota:export:all": "bun run ota:export:android && bun run ota:export:ios",
    "eas:build:android": "bunx eas-cli@latest build -p android --profile production",
    "eas:build:ios": "bunx eas-cli@latest build -p ios --profile production",
    "eas:build:all": "bunx eas-cli@latest build --platform all --profile production",
    "eas:build:dev:android": "bunx eas-cli@latest build -p android --profile development",
    "eas:build:dev:ios": "bunx eas-cli@latest build -p ios --profile development",
    "eas:submit:android": "bunx eas-cli@latest submit -p android --profile production --latest",
    "eas:submit:ios": "bunx eas-cli@latest submit -p ios --profile production --latest",
    "prepare": "husky"
  }
}
